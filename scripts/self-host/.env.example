# Copy to scripts/self-host/.env. Node --env-file supplies these to Compose.
# This file contains paths and immutable image references, never AI/DB keys.
# Resolve real reviewed digests in the admitted environment; none are invented.
# Node reference: node:24.18.0-bookworm-slim@sha256:<actual digest>
# Go reference: golang:1.26.8-bookworm@sha256:<actual digest>
# PostgreSQL 17.11-alpine3.24 is the current demo candidate, NOT admission proof.
CLOUDMARKUP_NODE_IMAGE=
CLOUDMARKUP_GO_IMAGE=
CLOUDMARKUP_POSTGRES_IMAGE=
CLOUDMARKUP_SELF_HOST_IMAGE=cloudmarkup-self-host:local
CLOUDMARKUP_SELF_HOST_PROJECT=cloudmarkup-self-host

# Absolute private paths outside this repository. Forward slashes work on Windows.
CLOUDMARKUP_SELF_HOST_CONFIGURATION_SOURCE=C:/CloudMarkupPrivate/runtime.json
CLOUDMARKUP_RUNTIME_SECRETS_DIRECTORY=C:/CloudMarkupPrivate/runtime-secrets
CLOUDMARKUP_POSTGRES_OWNER_PASSWORD_FILE=C:/CloudMarkupPrivate/postgres-owner.txt
CLOUDMARKUP_MIGRATOR_PASSWORD_FILE=C:/CloudMarkupPrivate/migrator.txt
CLOUDMARKUP_OPERATOR_CONFIGURATION_SOURCE=C:/CloudMarkupPrivate/operator.json
CLOUDMARKUP_PROVISIONING_CONFIGURATION_SOURCE=C:/CloudMarkupPrivate/provisioning.json
CLOUDMARKUP_OWNER_CONFIGURATION_SOURCE=C:/CloudMarkupPrivate/owner.json
CLOUDMARKUP_DATABASE_SECRETS_DIRECTORY=C:/CloudMarkupPrivate/runtime-secrets/database
