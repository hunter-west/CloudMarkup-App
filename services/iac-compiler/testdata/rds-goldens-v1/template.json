        "ApplyImmediately": false,
        "AutoMinorVersionUpgrade": false,
        "BackupRetentionPeriod": 7,
        "CACertificateIdentifier": "rds-ca-rsa2048-g1",
        "CopyTagsToSnapshot": true,
        "DBInstanceClass": "db.t4g.small",
        "DBInstanceIdentifier": "synthetic-postgres",
        "DBName": "SyntheticApp",
        "DBParameterGroupName": {
          "Ref": "DbParameters"
        },
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "DeletionProtection": true,
        "EnableIAMDatabaseAuthentication": false,
        "EnablePerformanceInsights": false,
        "Engine": "postgres",
        "EngineLifecycleSupport": "open-source-rds-extended-support-disabled",
        "EngineVersion": "16.6",
        "ManageMasterUserPassword": true,
        "MasterUsername": "SyntheticAdmin",
        "MonitoringInterval": 0,
        "MultiAZ": false,
        "Port": "5432",
        "PreferredBackupWindow": "02:00-02:30",
        "PreferredMaintenanceWindow": "sun:03:00-sun:03:30",
        "PubliclyAccessible": false,
        "StorageEncrypted": true,
        "StorageType": "gp3",
        "Tags": [
          {
            "Key": "CloudMarkupArchitecture",
            "Value": "architecture_notes"
          },
          {
            "Key": "CloudMarkupRevision",
            "Value": "revision_notes_1"
          },
          {
            "Key": "CloudMarkupSolutionRevision",
            "Value": "solution_notes_1"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudMarkup"
          }
        ],
        "VPCSecurityGroups": [
          {
            "Fn::GetAtt": [
              "Group",
              "GroupId"
            ]
          }
        ]
      },
      "Metadata": {
        "CloudMarkup": {
          "DeploymentKey": "database",
          "GraphId": "database",
          "Ownership": "user",
          "TargetKey": "database"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DbParameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "DBParameterGroupName": "synthetic-postgres-tls",
