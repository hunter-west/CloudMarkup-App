{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudMarkup deterministic curated serverless, networking, and event-driven application infrastructure.",
  "Metadata": {
    "CloudMarkup": {
      "ArchitectureRevisionId": "revision_notes_1",
      "CatalogDigest": "sha256:8e9b1b23bbcdf723352044baddd8e79468d70ed5a719af914036992daf91fb94",
      "CatalogVersion": "0.30.0",
      "Compiler": "cloudmarkup.iac-compiler@1.2.1",
      "SolutionRevisionId": "solution_notes_1"
    }
  },
  "Resources": {
    "ApplicationKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "BypassPolicyLockoutSafetyCheck": false,
        "Description": "Synthetic application encryption",
        "EnableKeyRotation": true,
        "Enabled": true,
        "KeyPolicy": {
          "Statement": [
            {
              "Action": [
                "kms:DescribeKey",
                "kms:GetKeyPolicy",
                "kms:PutKeyPolicy"
              ],
              "Effect": "Allow",
              "Principal": {
                "AWS": [
                  "arn:aws:iam::000000000000:role/synthetic-key-admin"
                ]
              },
              "Resource": [
                "*"
              ],
              "Sid": "KeyAdmin"
            }
          ],
          "Version": "2012-10-17"
        },
        "KeySpec": "SYMMETRIC_DEFAULT",
        "KeyUsage": "ENCRYPT_DECRYPT",
        "MultiRegion": false,
        "Origin": "AWS_KMS",
        "PendingWindowInDays": 30,
        "RotationPeriodInDays": 365,
        "Tags": [
          {
            "Key": "CloudMarkupArchitecture",
            "Value": "architecture_notes"
          },
          {
            "Key": "CloudMarkupRevision",
            "Value": "revision_notes_1"
          },
          {
            "Key": "CloudMarkupSolutionRevision",
            "Value": "solution_notes_1"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudMarkup"
          }
        ]
      },
      "Metadata": {
        "CloudMarkup": {
          "DeploymentKey": "application_key",
          "GraphId": "encryption_key",
          "Ownership": "user",
          "TargetKey": "application_key"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApplicationSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "Externally populated synthetic credential",
        "KmsKeyId": {
          "Fn::GetAtt": [
            "ApplicationKey",
            "Arn"
          ]
        },
        "Name": "application/credential",
        "Tags": [
          {
            "Key": "CloudMarkupArchitecture",
            "Value": "architecture_notes"
          },
          {
            "Key": "CloudMarkupRevision",
            "Value": "revision_notes_1"
          },
          {
            "Key": "CloudMarkupSolutionRevision",
            "Value": "solution_notes_1"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudMarkup"
          }
        ]
      },
      "Metadata": {
        "CloudMarkup": {
          "DeploymentKey": "application_secret",
          "GraphId": "secret",
          "Ownership": "user",
          "TargetKey": "application_secret"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SecretReader": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": [
                "sts:AssumeRole"
              ],
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Sid": "readertrust"
            }
          ],
          "Version": "2012-10-17"
        },
        "Description": "CloudMarkup notes-API Lambda execution role.",
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Ref": "ApplicationSecret"
                    }
                  ],
                  "Sid": "secretaccess"
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "secret_access"
          }
        ],
        "RoleName": "synthetic-secret-reader",
        "Tags": [
          {
            "Key": "CloudMarkupArchitecture",
            "Value": "architecture_notes"
          },
          {
            "Key": "CloudMarkupRevision",
            "Value": "revision_notes_1"
          },
          {
            "Key": "CloudMarkupSolutionRevision",
            "Value": "solution_notes_1"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudMarkup"
          }
        ]
      },
      "Metadata": {
        "CloudMarkup": {
          "DeploymentKey": "secret_reader",
          "GraphId": "reader_role",
          "Ownership": "user",
          "TargetKey": "secret_reader"
        }
      }
    }
  }
}
