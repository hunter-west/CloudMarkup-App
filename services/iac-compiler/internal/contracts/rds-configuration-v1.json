{
  "aws.rds.db-instance": {
    "allowMajorUpgrade": {
      "const": false,
      "default": false,
      "type": "boolean"
    },
    "autoMinorUpgrade": {
      "const": false,
      "default": false,
      "type": "boolean"
    },
    "backupRetentionDays": {
      "default": 7,
      "maximum": 35,
      "minimum": 1,
      "type": "integer"
    },
    "backupWindow": {
      "default": "02:00-02:30",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]-(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
      "type": "string"
    },
    "caIdentifier": {
      "enum": ["rds-ca-rsa2048-g1", "rds-ca-rsa4096-g1", "rds-ca-ecc384-g1"],
      "type": "string"
    },
    "databaseName": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "type": "string"
    },
    "deletionProtection": {
      "const": true,
      "default": true,
      "type": "boolean"
    },
    "encryptionMode": {
      "default": "aws-managed",
      "enum": ["aws-managed"],
      "type": "string"
    },
    "engine": {
      "default": "postgres",
      "enum": ["postgres"],
      "type": "string"
    },
    "engineVersion": {
      "pattern": "^16\\.[1-9][0-9]?$",
      "type": "string"
    },
    "extendedSupport": {
      "default": "disabled",
      "enum": ["disabled"],
      "type": "string"
    },
    "iamAuthentication": {
      "const": false,
      "default": false,
      "type": "boolean"
    },
    "identifier": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "instanceClass": {
      "enum": ["db.t4g.micro", "db.t4g.small", "db.t4g.medium"],
      "type": "string"
    },
    "maintenanceWindow": {
      "default": "sun:03:00-sun:03:30",
      "pattern": "^(?:mon|tue|wed|thu|fri|sat|sun):(?:[01][0-9]|2[0-3]):[0-5][0-9]-(?:mon|tue|wed|thu|fri|sat|sun):(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
      "type": "string"
    },
    "masterAuthMode": {
      "default": "rds-managed",
      "enum": ["rds-managed"],
      "type": "string"
    },
    "masterUsername": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "type": "string"
    },
    "monitoringInterval": {
      "default": 0,
      "enum": [0],
      "type": "integer"
    },
    "multiAz": {
      "default": false,
      "type": "boolean"
    },
    "performanceInsights": {
      "const": false,
      "default": false,
      "type": "boolean"
    },
    "port": {
      "default": 5432,
      "enum": [5432],
      "type": "integer"
    },
    "publicAccess": {
      "const": false,
      "default": false,
      "type": "boolean"
    },
    "retain": {
      "const": true,
      "default": true,
      "type": "boolean"
    },
    "storageEncrypted": {
      "const": true,
      "default": true,
      "type": "boolean"
    },
    "storageGiB": {
      "maximum": 399,
      "minimum": 20,
      "type": "integer"
    },
    "storageType": {
      "default": "gp3",
      "enum": ["gp3"],
      "type": "string"
    }
  },
  "aws.rds.db-parameter-group": {
    "description": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "family": {
      "default": "postgres16",
      "enum": ["postgres16"],
      "type": "string"
    },
    "forceTls": {
      "const": true,
      "default": true,
      "type": "boolean"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "retain": {
      "const": true,
      "default": true,
      "type": "boolean"
    }
  },
  "aws.rds.db-subnet-group": {
    "description": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "name": {
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "retain": {
      "const": true,
      "default": true,
      "type": "boolean"
    }
  }
}
