{
  "name": "@cloudmarkup/diagram-export",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "import": "./dist/conformance.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudmarkup/domain": "workspace:*",
    "@cloudmarkup/provider-sdk": "workspace:*",
    "@cloudmarkup/schemas": "workspace:*",
    "@fontsource/inter": "catalog:",
    "@resvg/resvg-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/application-generator": "workspace:*",
    "@cloudmarkup/config": "workspace:*",
    "@cloudmarkup/provider-aws": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
