  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:artifacts": "pnpm build && pnpm verify:artifacts",
    "check:json-schema": "pnpm check:artifacts",
    "generate:artifacts": "pnpm build && node scripts/generate-json-schema.mjs --write",
    "generate:json-schema": "pnpm generate:artifacts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "verify:artifacts": "node scripts/generate-json-schema.mjs --check"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/config": "workspace:*",
    "typescript": "catalog:"
  }
