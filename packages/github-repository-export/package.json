{
  "name": "@cloudmarkup/github-repository-export",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./dist/contracts.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./dist/errors.js"
    },
    "./ports": {
      "types": "./src/ports.ts",
      "import": "./dist/ports.js"
    },
    "./service": {
      "types": "./src/service.ts",
      "import": "./dist/service.js"
    },
    "./webhook": {
      "types": "./src/webhook.ts",
      "import": "./dist/webhook.js"
    },
    "./testing": {
      "types": "./src/fakes.ts",
      "import": "./dist/fakes.js"
    },
    "./repository-import": {
      "types": "./src/repository-import.ts",
      "import": "./dist/repository-import.js"
    },
    "./repository-import-runner": {
      "types": "./src/repository-import-runner.ts",
      "import": "./dist/repository-import-runner.js"
    },
    "./repository-refresh": {
      "types": "./src/repository-refresh.ts",
      "import": "./dist/repository-refresh.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project=github-repository-export"
  },
  "dependencies": {
    "@cloudmarkup/schemas": "workspace:*",
    "@cloudmarkup/solution-export": "workspace:*",
    "zod": "catalog:",
    "@cloudmarkup/repository-importer": "workspace:*"
  },
  "devDependencies": {
    "@cloudmarkup/application-generator": "workspace:*",
    "@cloudmarkup/config": "workspace:*",
    "@cloudmarkup/customer-ci-workflow": "workspace:*",
    "@cloudmarkup/solution-export-workflow": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@cloudmarkup/provider-aws": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
