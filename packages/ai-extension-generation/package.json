{
  "name": "@cloudmarkup/ai-extension-generation",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./presentation": {
      "types": "./src/presentation.ts",
      "import": "./dist/presentation.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudmarkup/application-build-runner": "workspace:*",
    "@cloudmarkup/domain": "workspace:*",
    "@cloudmarkup/model-gateway": "workspace:*",
    "@cloudmarkup/repository-importer": "workspace:*",
    "@cloudmarkup/schemas": "workspace:*",
    "@cloudmarkup/terraform-validation-runner": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/application-generator": "workspace:*",
    "@cloudmarkup/config": "workspace:*",
    "@cloudmarkup/provider-aws": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
