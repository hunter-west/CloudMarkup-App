{
  "name": "@cloudmarkup/ui",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "storybook": "storybook dev --port 6006 --disable-telemetry --no-version-updates",
    "storybook:build": "storybook build --output-dir storybook-static --disable-telemetry",
    "type-check": "tsc -p tsconfig.json",
    "test": "pnpm --dir ../.. exec vitest run --project ui"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
