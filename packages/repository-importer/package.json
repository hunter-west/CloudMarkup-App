{
  "name": "@cloudmarkup/repository-importer",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project=repository-importer"
  },
  "dependencies": {
    "@cloudmarkup/domain": "workspace:*",
    "@cloudmarkup/provider-sdk": "workspace:*",
    "@cloudmarkup/schemas": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/application-generator": "workspace:*",
    "@cloudmarkup/config": "workspace:*",
    "@cloudmarkup/provider-aws": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
