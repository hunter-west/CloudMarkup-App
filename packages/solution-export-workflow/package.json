{
  "name": "@cloudmarkup/solution-export-workflow",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/public-contracts.ts",
      "import": "./dist/public-contracts.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudmarkup/application-generator": "workspace:*",
    "@cloudmarkup/application-build-runner": "workspace:*",
    "@cloudmarkup/diagram-export": "workspace:*",
    "@cloudmarkup/domain": "workspace:*",
    "@cloudmarkup/provider-sdk": "workspace:*",
    "@cloudmarkup/job-framework": "workspace:*",
    "@cloudmarkup/schemas": "workspace:*",
    "@cloudmarkup/solution-export": "workspace:*",
    "@cloudmarkup/terraform-validation-runner": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudmarkup/config": "workspace:*",
    "@types/node": "catalog:",
    "@cloudmarkup/provider-aws": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
