# Credentialless local-development defaults. The root local:* scripts enforce these
# modes, a loopback-only database, and the repo-bounded filesystem object root.
CLOUDMARKUP_RUNTIME_ENVIRONMENT=local
CLOUDMARKUP_IDENTITY_MODE=local
# Select one seeded local identity; local:web validates and injects it into Vite.
CLOUDMARKUP_LOCAL_IDENTITY_TOKEN=local-owner
CLOUDMARKUP_OBJECT_STORE_MODE=filesystem
CLOUDMARKUP_MODEL_PROVIDER_MODE=fake
CLOUDMARKUP_FILESYSTEM_OBJECT_ROOT=tmp/cloudmarkup-local-pg17-v1/objects
CLOUDMARKUP_JOB_MODE=fake
CLOUDMARKUP_BILLING_MODE=fake
CLOUDMARKUP_LOCAL_POSTGRES_PORT=55432
CLOUDMARKUP_LOCAL_MIGRATION_PROFILE=cloudmarkup-standalone-pg17-v1
CLOUDMARKUP_DATABASE_URL=postgresql://cloudmarkup_beta_api_runtime:cloudmarkup-local-api-runtime-only@127.0.0.1:55432/cloudmarkup
# Privileged URLs are used only by explicit local bootstrap/migration commands.
# The launcher removes them from API/browser child environments.
CLOUDMARKUP_LOCAL_MIGRATOR_DATABASE_URL=postgresql://cloudmarkup_admin:cloudmarkup-local-migrator-only@127.0.0.1:55432/cloudmarkup
CLOUDMARKUP_LOCAL_BOOTSTRAP_DATABASE_URL=postgresql://cloudmarkup_owner:cloudmarkup-local-bootstrap-only@127.0.0.1:55432/cloudmarkup

CLOUDMARKUP_BILLING_SUCCESS_URL=http://127.0.0.1:4173/settings/billing?checkout=success
CLOUDMARKUP_BILLING_CANCEL_URL=http://127.0.0.1:4173/settings/billing?checkout=canceled
CLOUDMARKUP_BILLING_PORTAL_RETURN_URL=http://127.0.0.1:4173/settings/billing

# Optional reviewed Stripe sandbox configuration is intentionally inactive.
# Do not enable it for the credentialless local-development workflow.
# STRIPE_STARTER_PRODUCT_ID=prod_replace_with_reviewed_sandbox_product
# STRIPE_STARTER_PRICE_ID=price_replace_with_reviewed_monthly_sandbox_price
# STRIPE_PRO_PRODUCT_ID=prod_replace_with_reviewed_sandbox_product
# STRIPE_PRO_PRICE_ID=price_replace_with_reviewed_monthly_sandbox_price
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_with_reviewed_sandbox_configuration
# STRIPE_SECRET_KEY=resolve_from_local_secret_channel
# STRIPE_WEBHOOK_SECRET=resolve_from_local_secret_channel

# Live AI is unavailable in the documented local workflows in this snapshot.
# local:* composes fake/absent model services and rejects AWS credentials; the
# standalone core requires models and optional adapters to remain null. Keep
# CLOUDMARKUP_MODEL_PROVIDER_MODE=fake above. No Bedrock toggle or manual-smoke
# command in this file enables a local provider composition.
#
# The maintained application includes Bedrock/model-gateway code. A separately
# admitted configured-provider host also needs real IAM/model access, validated
# server-only routing/capability configuration, durable authorization and funding/
# usage records, compatible queue/storage/worker adapters and native acceptance.
# Those are prerequisites, not an implemented local setup recipe. Publishing
# source or changing an endpoint supplies none of them. Do not put credentials
# in VITE_ variables or use fake local credits to authorize real provider calls.
# See scripts/self-host/README.md for the core profile and pending acceptance.
# STRIPE_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
